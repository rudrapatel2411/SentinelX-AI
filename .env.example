# SentinelX AI Environment Variables Example
# Copy this file to .env and configure your keys as needed.

# Database (SQLite by default for zero-setup local dev; PostgreSQL supported via standard connection strings)
DATABASE_URL="file:./dev.db"

# AI Explanation Provider (Optional - deterministic technical analysis runs even without AI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional custom base URL (e.g. for self-hosted LLMs or Azure)
# OPENAI_BASE_URL=""

# Threat Intelligence APIs (Optional - local static analysis and heuristics run even without these)
# VirusTotal API v3 (Used for SHA-256 file hash reputation and URL scanning)
VIRUSTOTAL_API_KEY=""

# Google Safe Browsing API v4 (Used for URL threat lookups)
GOOGLE_SAFE_BROWSING_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
